{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "day",
          "value": "(?<id>[a-z0-9]{6,20})"
        }
      ],
      "destination": "/api/day-page?id=:id"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-blast",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron-photos",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron-checkin",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron-announce",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron-warm",
      "schedule": "*/5 * * * *"
    }
  ],
  "fluid": true
}