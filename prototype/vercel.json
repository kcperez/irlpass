{
  "rewrites": [
    {
      "source": "/v/:slug",
      "destination": "/api/venue?slug=:slug"
    },
    {
      "source": "/pro",
      "destination": "/index.html"
    },
    {
      "source": "/d/:id",
      "destination": "/api/day-page?id=:id"
    },
    {
      "source": "/traction",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-blast",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron-photos",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron-checkin",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron-announce",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron-warm",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron-events",
      "schedule": "0 9 * * *"
    }
  ],
  "fluid": true
}
