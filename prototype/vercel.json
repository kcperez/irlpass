{
  "rewrites": [
    {
      "source": "/start",
      "has": [
        {
          "type": "host",
          "value": "getty.irlpass.xyz"
        }
      ],
      "destination": "/api/venues-hub?view=start"
    },
    {
      "source": "/in",
      "has": [
        {
          "type": "host",
          "value": "getty.irlpass.xyz"
        }
      ],
      "destination": "/api/venues-hub?view=in"
    },
    {
      "source": "/g/:k",
      "has": [
        {
          "type": "host",
          "value": "getty.irlpass.xyz"
        }
      ],
      "destination": "/api/venues-hub?view=dash&k=:k"
    },
    {
      "source": "/venues",
      "destination": "/api/venues-hub?view=landing"
    },
    {
      "source": "/venues/start",
      "destination": "/api/venues-hub?view=start"
    },
    {
      "source": "/venues/in",
      "destination": "/api/venues-hub?view=in"
    },
    {
      "source": "/venues/g/:k",
      "destination": "/api/venues-hub?view=dash&k=:k"
    },
    {
      "source": "/v/:slug",
      "destination": "/api/venue?slug=:slug"
    },
    {
      "source": "/pro",
      "destination": "/index.html"
    },
    {
      "source": "/e/:id",
      "destination": "/api/event-page?id=:id"
    },
    {
      "source": "/p/:id",
      "destination": "/api/perk-page?id=:id"
    },
    {
      "source": "/pass/:code",
      "destination": "/api/perk-page?code=:code"
    },
    {
      "source": "/d/:id",
      "destination": "/api/day-page?id=:id"
    },
    {
      "source": "/traction",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-blast",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron-photos",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron-checkin",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron-announce",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron-warm",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron-events",
      "schedule": "0 9 * * *"
    }
  ],
  "fluid": true
}
